{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "paths": {
      "@pages/*": ["./src/pages/*"],
      "@tests/*": ["./src/tests/*"]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "globals/**/*"
  ],
  "exclude": [
    "tests/templates",
    "src/pages/katalon-demo-cura.herokuapp.com",
    "src/pages/saucedemo.com",
    "src/pages/vwo.com"
  ]
}